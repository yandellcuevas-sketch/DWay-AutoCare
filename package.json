{
  "name": "dway-autocare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-db-schema.mjs && prisma generate && next build",
    "build:render": "node scripts/prepare-db-schema.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:pg:deploy": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
